    "general.automaticUpdateChecks.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a day, Inverso checks GitHub for a new version. This is the only network request the app makes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в сутки Inverso проверяет на GitHub, не вышла ли новая версия. Это единственный сетевой запрос приложения."
          }
        }
      }
    },
    "general.feedback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After conversion, show"
