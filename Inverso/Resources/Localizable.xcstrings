    "smartMode.greedyLine.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selects text to the start of line, finds where the wrong layout begins, and converts the entire wrong-layout phrase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделяет текст до начала строки, находит место начала неправильной раскладки и конвертирует всю фразу."
          }
        }
      }
    },
    "smartMode.greedyLine.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greedy (Entire Phrase)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жадный (вся фраза)"
          }
        }
      }
    },
    "smartMode.lastWord.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converts only the last typed word before the cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конвертирует только последнее набранное слово перед курсором."
          }
        }
      }
    },
