    "hotkey.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press this shortcut to convert text. If text is selected it converts the selection; otherwise it auto-selects the last word."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите это сочетание клавиш для конвертации текста. Если текст выделен — конвертируется выделение; иначе автоматически выделяется последнее слово."
          }
        }
      }
    },
    "hotkey.doubleShiftHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly press Shift twice to trigger conversion. This is the recommended shortcut — fast and doesn't conflict with other apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро нажмите Shift дважды для конвертации. Рекомендуемое сочетание — быстрое и не конфликтует с другими приложениями."
          }
        }
      }
    },
    "hotkey.useDoubleShift": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Double Shift (⇧⇧) as shortcut"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать двойной Shift (⇧⇧)"
          }
        }
      }
    },
