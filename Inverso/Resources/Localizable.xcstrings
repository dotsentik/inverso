    "general.automaticUpdateChecks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates automatically"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять обновления автоматически"
