    "general.feedback.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlay: a short hint at the top of the screen, e.g. “ghbdtn → привет · RU”. It does not take focus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказка: короткая надпись вверху экрана, например «ghbdtn → привет · RU». Не забирает фокус."
          }
        }
      }
    },
    "general.feedback.hud": {
