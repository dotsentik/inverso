    "layoutSwitchMode.always.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always switch the keyboard layout after pressing the hotkey, regardless of whether text was converted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда переключать раскладку клавиатуры после нажатия горячей клавиши, независимо от того, был ли текст конвертирован."
          }
        }
      }
    },
    "layoutSwitchMode.always.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always switch layout"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда переключать раскладку"
          }
        }
      }
    },
    "layoutSwitchMode.ifAnyWord.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the layout if any word in the converted text needed reconversion to the correct layout."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключать раскладку, если хотя бы одно слово в конвертированном тексте потребовало преобразования."
          }
        }
      }
    },
    "layoutSwitchMode.ifAnyWord.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch if any word required conversion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключать, если хоть одно слово потребовало конвертации"
          }
        }
      }
    },
    "layoutSwitchMode.ifLastWord.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the layout only if the last word before the cursor was typed in the wrong layout and got reconverted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключать раскладку, только если последнее слово перед курсором было набрано в неправильной раскладке и было конвертировано."
          }
        }
      }
    },
    "layoutSwitchMode.ifLastWord.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch if last word was converted"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключать, если последнее слово было конвертировано"
          }
        }
      }
    },
