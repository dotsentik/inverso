    "layouts.dragHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order is priority. Drag rows or use ⌥⌘↑ / ⌥⌘↓ to reorder; uncheck a layout to ignore it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок — это приоритет. Перетаскивайте строки или используйте ⌥⌘↑ / ⌥⌘↓; снимите галочку, чтобы не использовать раскладку."
          }
        }
      }
    },
